<!--
  Protege el código que se usa por reflexión para que el "Managed Stripping Level: High"
  no lo borre del APK:
   - Assembly-CSharp: los botones llaman a métodos de ControlMaceta por nombre.
   - URP: los efectos del Volume (Bloom, Vignette, Depth of Field...) se cargan por reflexión.
   - Input System: los módulos de entrada de la UI.
-->
<linker>
  <assembly fullname="Assembly-CSharp" preserve="all" />
  <assembly fullname="Unity.RenderPipelines.Core.Runtime" preserve="all" />
  <assembly fullname="Unity.RenderPipelines.Universal.Runtime" preserve="all" />
  <assembly fullname="Unity.InputSystem" preserve="all" />
</linker>
